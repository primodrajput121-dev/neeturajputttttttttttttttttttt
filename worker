// Standalone Worker for Non-Vercel Node environment fallback
import nodemailer from 'nodemailer';

export async function sendEmailTask({ email, appPassword, recipient, subject, messageBody, senderName }) {
  try {
    const transporter = nodemailer.createTransport({
      service: "gmail",
      auth: { user: email, pass: appPassword }
    });

    const cleanSenderName = (senderName || "").replace(/"/g, "").trim();

    const mailOptions = {
      from: cleanSenderName ? `"${cleanSenderName}" <${email}>` : email,
      to: recipient,
      subject: subject,
      text: messageBody
    };

    const info = await transporter.sendMail(mailOptions);
    return { success: true, recipient, messageId: info.messageId };
  } catch (error) {
    return { success: false, recipient, error: error.message };
  }
}
